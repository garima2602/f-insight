# F-Insight Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Security (required in production) ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FINSIGHT_SECRET_KEY=change-me-to-a-long-random-string-minimum-32-chars

# JWT token lifetime in minutes (default: 10080 = 7 days)
FINSIGHT_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (no setup required)
# DATABASE_URL=sqlite+aiosqlite:///data/finsight.db

# PostgreSQL (uncomment and fill in for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/finsight

# ── Cache (optional) ──────────────────────────────────────────────────────────
# Leave empty to disable caching (app works fine without Redis)
# REDIS_URL=redis://localhost:6379/0

# ── Ollama (optional) ─────────────────────────────────────────────────────────
# AI chat falls back to rule-based responses if Ollama is not running
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# ── OCR (optional) ────────────────────────────────────────────────────────────
# Required only for scanned PDFs and image uploads
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\Program Files\poppler\Library\bin

# ── Dev only ──────────────────────────────────────────────────────────────────
# Set to true to use an in-memory database (tests only, data lost on restart)
# RAM_ONLY_MODE=false
